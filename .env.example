# Copia este archivo como .env para desarrollar en tu computadora, y pon los mismos valores
# en Vercel → Project → Settings → Environment Variables. Nunca subas el .env a GitHub.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Cualquier texto largo al azar (sirve para guardar la IP como huella, no en claro)
IP_SALT=
# Tu clave para entrar al panel y al reporte (texto largo al azar)
REPORTE_CLAVE=

# ===== Todo por WhatsApp =====
# API oficial de WhatsApp (Meta → WhatsApp → API Setup). Con esto los mensajes salen solos:
# verificación al cliente, la cita a la desarrolladora y tus avisos. Plantillas en api/_lib/whatsapp.js.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Tu WhatsApp (10 dígitos), para tus avisos
ARVENTA_WHATSAPP=6184463867
# Respaldo para tus avisos mientras la API no esté lista: CallMeBot (callmebot.com), tu número con +52 y su llave
CALLMEBOT_TELEFONO=+526184463867
CALLMEBOT_APIKEY=

# ===== Asistente con IA (api/asistente.js) =====
# Llave de la API de Claude (console.anthropic.com → API Keys). Vacía = modo demostración con reglas sencillas.
ANTHROPIC_API_KEY=
# Modelo (opcional). Uno rápido y barato basta para buscar; cambia a uno más grande si quieres respuestas más finas.
ANTHROPIC_MODEL=claude-haiku-5-5
