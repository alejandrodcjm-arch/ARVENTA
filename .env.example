# Copia este archivo como .env para desarrollar en tu computadora, y pon los mismos valores
# en Vercel → Project → Settings → Environment Variables. Nunca subas el .env a GitHub.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Cualquier texto largo al azar (sirve para guardar la IP como huella, no en claro)
IP_SALT=
# Clave para abrir reporte.html (texto largo al azar)
REPORTE_CLAVE=

# Aviso inmediato de cada solicitud (configura al menos uno)
# Correo con Resend (resend.com): llave, para quién y desde qué remitente verificado
RESEND_API_KEY=
AVISO_CORREO_PARA=
AVISO_CORREO_DE=ARVENTA <avisos@arventa.mx>
# WhatsApp con CallMeBot (callmebot.com): tu número con +52 y la llave que te da su bot
CALLMEBOT_TELEFONO=+526184463867
CALLMEBOT_APIKEY=
